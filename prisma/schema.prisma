// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoomState {
  id          String   @id
  queue       Json     @default("[]")
  history     Json     @default("[]")
  currentSong Json?
  updatedAt   DateTime @updatedAt
}

model Gift {
  id        String   @id @default(cuid())
  amount    Int      @default(1)
  message   String?
  createdAt DateTime @default(now())
}

model ChangelogEntry {
  id          String   @id @default(uuid()) // Upgraded to uuid() to prevent deprecation warnings
  version     String
  date        DateTime @default(now())
  title       String
  description String?
  type        String   // e.g., "feature", "fix", "improvement"
  
  // FIX: This correctly tells PostgreSQL to instantiate a valid, empty JSON array structure
  listItems   Json     @default(dbgenerated("'[]'::jsonb")) 
  
  createdAt   DateTime @default(now())
}
